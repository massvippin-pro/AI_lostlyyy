# ==============================================================================
# AI Lost-and-Found Matcher - Environment Configuration
# ==============================================================================

# Database Connection (Supabase PostgreSQL)
# Project Reference: kslmawbhfengkrnxmymg
#
# Direct connection (Session mode, port 5432):
# DATABASE_URL=postgresql+psycopg://postgres:[YOUR-DB-PASSWORD]@db.kslmawbhfengkrnxmymg.supabase.co:5432/postgres?sslmode=require
#
# Or Supabase Connection Pooler (Transaction mode, port 6543):
# DATABASE_URL=postgresql+psycopg://postgres.kslmawbhfengkrnxmymg:[YOUR-DB-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# Local SQLite fallback for offline development/testing:
# DATABASE_URL=sqlite:///./lost_and_found.db
DATABASE_URL=sqlite:///./lost_and_found.db

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Metadata
APP_NAME=AI Lost and Found Matcher
APP_VERSION=1.0.0

# CORS Origins (Comma-separated list of allowed origins)
# Example: Next.js (port 3000), Expo React Native / Web (port 8081, 19006), Vite (5173)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006,http://localhost:5173

# Server Port (Railway automatically sets PORT at runtime)
PORT=8000
HOST=0.0.0.0
